# Copy this file to .env and fill in real values. Never commit .env.
#
# This template is committed on purpose (see the !.env.example rule in
# .gitignore) because it is the only record of what a deployment needs.
# It carries variable NAMES ONLY. Never put a real value in this file —
# anything committed here is public permanently, even if deleted later.

# --- Required in every environment ---------------------------------------

# PostgreSQL connection string (Neon or Supabase in production, local
# Postgres in dev). For Neon, prefer the pooled endpoint.
# Connection timeouts are configured in src/lib/db.ts rather than as query
# parameters here, so they hold however this URL happens to be written.
DATABASE_URL=

# Signs the staff, patient and admin session JWTs (jose).
# Must be at least 32 characters; validated at server boot by
# src/instrumentation.ts, so a weak or missing value fails the deploy
# rather than surfacing on someone's first login.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# The public origin this deployment serves from, e.g. https://apnahealth.in
# (scheme + host, no trailing path). Used for canonical URLs, the sitemap,
# Open Graph tags and JSON-LD — all of which must be absolute.
#
# Unset, it falls back to http://localhost:3000, which is correct in
# development and WRONG in production: search engines would be told every
# page's canonical address is localhost. Set it on every deployed
# environment, including previews.
SITE_URL=

# Comma-separated hostnames that may host doctor photos, e.g.
#   IMAGE_HOSTS=images.apnahealth.in,res.cloudinary.com
#
# Read by BOTH src/lib/images.ts (which rejects a photo URL on any other
# host) and next.config.ts (which lets next/image optimize these and only
# these). Leave it blank until there is somewhere to host images: an
# unlisted https host is still accepted and rendered, just never fetched by
# the server, because the image optimizer fetching an arbitrary
# user-supplied URL is server-side request forgery.
IMAGE_HOSTS=

# Map tile source for the static maps on discovery and facility pages.
# Defaults to OpenStreetMap, which is free and keyless — and whose usage
# policy forbids heavy application use, so it is fine for development and a
# pilot and must be replaced before launch. Set to "off" to drop the basemap
# entirely (pins still render). See docs/product/MAP_TILES.md.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
MAP_TILE_ATTRIBUTION_URL=

# Where uncaught errors are forwarded, as a JSON POST. Any endpoint that
# accepts one: a Slack/Discord incoming webhook, your own function, a log
# pipeline. Unset, errors are still written to the console — this only adds
# a destination, it never replaces the log.
#
# The payload carries the message, a hashed fingerprint and the explicit log
# context. Never a stack, a request body, cookies, or patient data.
# See docs/product/MONITORING.md.
ERROR_WEBHOOK_URL=

# --- Required in production; optional locally ----------------------------

# Outbound email, used only for password reset links (src/lib/mailer.ts).
# Sent via the Resend HTTP API — no npm package involved.
# Leave blank in development and the reset link is printed to the dev server
# console instead. In production a blank value makes /forgot-password refuse
# the request rather than claim an email was sent that never was.
# Get a key at https://resend.com
RESEND_API_KEY=

# From address for those emails. Must be on a domain verified with the mail
# provider. Falls back to Resend's shared onboarding sender if unset, which
# is fine for testing and not for production.
MAIL_FROM=

# --- Local development only ----------------------------------------------
# Used exclusively by prisma/seed.ts. Never set these in production; the
# seed refuses to run there regardless (src/lib/seedGuard.ts).
#
# The seeded staff logins. These used to be hardcoded in prisma/seed.ts,
# which published four working passwords to a public repository — hence
# they now come from here, and the seed fails closed if they are unset.
# Minimum 8 characters. Use throwaway values; never reuse a real password.
SEED_OWNER_PASSWORD=
SEED_FRONT_DESK_PASSWORD=
SEED_DOCTOR_PASSWORD=

# The seeded patient login (phone 9000000006), which is how the patient-side
# of the product — appointments, live queue, ticket pages — is demonstrable
# at all: without an account, every seeded token is an unowned snapshot and
# those pages are empty for everyone. Same rules as the staff passwords
# above: minimum 8 characters, throwaway value, fails closed if unset.
SEED_PATIENT_PASSWORD=

# Deliberately absent: there is no SEED_ADMIN_PASSWORD. A PlatformAdmin can
# approve any facility and verify any doctor across every tenant, so it is
# never created by a script. Create one with:
#   ADMIN_EMAIL=... ADMIN_NAME="..." ADMIN_PASSWORD='...' npm run admin:create

# The seed deletes clinical records, so it refuses any non-local database
# unless you name that database's exact hostname here. Leave blank for a
# local Postgres. Not needed in .env — pass it on the command line for the
# one run that needs it:
#   SEED_ALLOW_HOST=<host> npx prisma db seed
SEED_ALLOW_HOST=
