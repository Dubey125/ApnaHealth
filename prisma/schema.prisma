// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Data model contract: docs/product/DATA_MODEL.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  OWNER
  FRONT_DESK
  DOCTOR
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Platform-side review of a facility that signed itself up. Distinct from
// VerificationStatus, which is about a *doctor's* medical registration:
// a facility can be approved to operate on ApnaHealth while its doctors
// are still unverified, and vice versa.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Which table a polymorphic row points at. ApnaHealth has three separate
// account tables by design (Patient, StaffUser, PlatformAdmin) — they have
// different identifiers, different sessions and different blast radius —
// so anything shared across all three carries this discriminator instead
// of a foreign key.
enum AccountKind {
  PATIENT
  STAFF
  ADMIN
}

enum SessionStatus {
  SCHEDULED
  OPEN
  IN_PROGRESS
  PAUSED
  CLOSED
}

enum TokenSource {
  WALK_IN
  SELF_BOOK
}

enum TokenStatus {
  BOOKED
  CHECKED_IN
  IN_CONSULT
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum QueueEventType {
  TOKEN_ISSUED
  CHECKED_IN
  CONSULT_STARTED
  CONSULT_ENDED
  MARKED_NO_SHOW
  CANCELLED
  SESSION_OPENED
  SESSION_PAUSED
  SESSION_RESUMED
  SESSION_CLOSED
  TOKEN_REORDERED
}

enum RecordAccessAction {
  VIEW
  CREATE
  UPDATE
}

// A hospital is not a separate entity from a clinic — it is the same
// facility record (address, doctors, sessions, queue, staff) at a
// different scale. Modelled as a field on Clinic rather than a parallel
// Hospital table so none of the seven relations hanging off Clinic have to
// be duplicated: the same reasoning that kept "appointment" as a view of
// Token instead of its own table.
enum FacilityType {
  CLINIC
  HOSPITAL
}

model Clinic {
  id                String         @id @default(cuid())
  name              String
  facilityType      FacilityType   @default(CLINIC)
  addressLine       String
  // Locality / neighbourhood ("Koregaon Park"), the unit people actually
  // search by in Indian cities — city alone is too coarse in a metro and
  // the full addressLine is too specific to match on.
  areaLabel         String?
  city              String
  state             String
  postalCode        String?
  phone             String
  timezone          String         @default("Asia/Kolkata")
  isActive          Boolean        @default(true)
  // Platform review gate for self-serve signup. Anyone can create a
  // facility from the public /register pages, so "a row exists" must not
  // by itself mean "listed to patients" — every public discovery and
  // booking query filters on APPROVED. isActive stays separate: it is the
  // facility's own on/off switch (temporarily closed), not our decision.
  // Existing rows were backfilled to APPROVED by the migration; only new
  // signups start PENDING.
  approvalStatus    ApprovalStatus @default(PENDING)
  approvalDecidedAt DateTime?      @db.Timestamptz(3)
  approvalNotes     String?
  reviewedByAdminId String?
  reviewedByAdmin   PlatformAdmin? @relation("ClinicReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  staffUsers          StaffUser[]
  doctors             Doctor[]
  sessions            Session[]
  consultationRecords ConsultationRecord[]
  recordConsents      RecordConsent[]
  recordAccessEvents  RecordAccessEvent[]
  auditEvents         AuditEvent[]
}

model StaffUser {
  id           String    @id @default(cuid())
  clinicId     String
  clinic       Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole
  doctorId     String?   @unique
  doctor       Doctor?   @relation("StaffUserDoctorProfile", fields: [doctorId], references: [id], onDelete: SetNull)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  queueEvents         QueueEvent[]
  verifiedDoctors     Doctor[]             @relation("DoctorVerifiedBy")
  doctorVerifications DoctorVerification[]
  recordAccessEvents  RecordAccessEvent[]

  @@index([clinicId])
}

// Cascade delete stops here: a Clinic delete cascades through StaffUser,
// Doctor and Session, but everything below Session (Token, QueueEvent,
// PredictionSnapshot) and everything record/audit-related (Doctor
// verification history, consultation records, consent, access/audit
// events) is Restrict/SetNull (Prisma's default when onDelete is
// omitted) so real activity or history can't be deleted out from under
// itself.
model Doctor {
  id                    String             @id @default(cuid())
  clinicId              String
  clinic                Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name                  String
  // Public, human-readable identifier for /doctors/[slug]. DATA_MODEL.md
  // doesn't list this field, but MVP_SPEC.md's route needs a non-internal
  // identifier, and "internal IDs never go into public URLs" (DATA_MODEL.md)
  // rules out using `id` directly.
  slug                  String             @unique
  specialty             String
  qualificationText     String
  registrationNumber    String?
  registrationCouncil   String?
  experienceYears       Int?
  languagesText         String?
  consultationFeeMinor  Int?
  bio                   String?
  photoUrl              String?
  // Public contact details for the doctor's own profile. Distinct from
  // Clinic.phone (the facility switchboard) — a patient looking at a
  // doctor page needs to know how to reach that practitioner, and a
  // multi-location doctor is not reachable on any one clinic's number.
  // Deliberately not unique: a doctor may legitimately publish a shared
  // practice address, and StaffUser.email already carries the unique
  // login identity.
  phone                 String?
  email                 String?
  // Not in DATA_MODEL.md's Doctor field list, but QUEUE_RULES.md's
  // prediction baseline explicitly requires "doctor's default consultation
  // minutes" as its last fallback tier — added to close that gap.
  defaultConsultMinutes Int                @default(6)
  verificationStatus    VerificationStatus @default(PENDING)
  verifiedAt            DateTime?          @db.Timestamptz(3)
  // Exactly one of these two is set on a verified doctor. Clinic owners
  // could originally verify their own doctors, which self-signup turned
  // into self-verification (a doctor who registers becomes the OWNER of
  // their own practice) — CLAUDE.md: verification "must never be
  // fabricated or treated as automatic truth". Medical-registration checks
  // are now the platform's call; the staff column is kept so historic
  // clinic-recorded checks stay attributable.
  verifiedByStaffUserId String?
  verifiedByStaffUser   StaffUser?         @relation("DoctorVerifiedBy", fields: [verifiedByStaffUserId], references: [id], onDelete: SetNull)
  verifiedByAdminId     String?
  verifiedByAdmin       PlatformAdmin?     @relation("DoctorVerifiedByAdmin", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)
  verificationSource    String?
  verificationNotes     String?
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)

  staffAccount        StaffUser?           @relation("StaffUserDoctorProfile")
  sessions            Session[]
  verifications       DoctorVerification[]
  consultationRecords ConsultationRecord[]
  recordConsents      RecordConsent[]
  recordAccessEvents  RecordAccessEvent[]

  @@index([clinicId])
  @@index([specialty])
  @@index([clinicId, verificationStatus])
}

model DoctorVerification {
  id                        String             @id @default(cuid())
  doctorId                  String
  doctor                    Doctor             @relation(fields: [doctorId], references: [id])
  // Nullable since the platform review team took over verification, but
  // one of the two reviewer columns is always populated (enforced in the
  // action that writes this row, which is the only writer).
  checkedByStaffUserId      String?
  checkedByStaffUser        StaffUser?         @relation(fields: [checkedByStaffUserId], references: [id])
  checkedByAdminId          String?
  checkedByAdmin            PlatformAdmin?     @relation(fields: [checkedByAdminId], references: [id])
  status                    VerificationStatus
  registrationNumberChecked String
  sourceName                String
  sourceReference           String?
  checkedAt                 DateTime           @db.Timestamptz(3)
  notes                     String?

  @@index([doctorId, checkedAt])
}

model Session {
  id             String        @id @default(cuid())
  clinicId       String
  clinic         Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  // Public identifier for /book/[sessionId] (linked from the public doctor
  // profile page) — same reasoning as Doctor.slug: DATA_MODEL.md's "internal
  // IDs never go into public URLs" rules out routing on `id` directly.
  // 21-char nanoid, generated in application code, same pattern as
  // Token.publicId.
  publicId       String        @unique
  sessionDate    DateTime      @db.Timestamptz(3)
  plannedStartAt DateTime      @db.Timestamptz(3)
  plannedEndAt   DateTime      @db.Timestamptz(3)
  locationLabel  String
  status         SessionStatus @default(SCHEDULED)
  actualStartAt  DateTime?     @db.Timestamptz(3)
  actualEndAt    DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  tokens              Token[]
  queueEvents         QueueEvent[]
  predictionSnapshots PredictionSnapshot[]
  scheduledBreaks     SessionBreak[]

  @@index([clinicId])
  @@index([doctorId])
}

// A planned, known-in-advance block of time (e.g. a fixed lunch break)
// during which the doctor is not consulting. Distinct from PAUSED session
// status: a pause is an unplanned, open-ended interruption handled by the
// existing pause/resume mechanism; a SessionBreak has a known startAt/endAt
// the prediction engine can schedule around in advance.
model SessionBreak {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  startAt   DateTime @db.Timestamptz(3)
  endAt     DateTime @db.Timestamptz(3)
  reason    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([sessionId, startAt])
}

model Token {
  id                   String      @id @default(cuid())
  sessionId            String
  session              Session     @relation(fields: [sessionId], references: [id])
  publicId             String      @unique
  tokenNumber          Int
  patientId            String?
  patient              Patient?    @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientNameSnapshot  String
  patientPhoneSnapshot String
  // Captured at the counter for a walk-in / offline booking, where there
  // is no Patient account to read age or sex from. Snapshots, like the
  // name and phone above: they describe who attended this visit and are
  // never back-filled from an account created later.
  patientAgeSnapshot   Int?
  patientSexSnapshot   String?
  reasonForVisit       String?
  source               TokenSource
  status               TokenStatus @default(BOOKED)
  issuedAt             DateTime    @default(now()) @db.Timestamptz(3)
  checkedInAt          DateTime?   @db.Timestamptz(3)
  consultStartedAt     DateTime?   @db.Timestamptz(3)
  consultEndedAt       DateTime?   @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(3)

  queueEvents         QueueEvent[]
  predictionSnapshots PredictionSnapshot[]
  consultationRecords ConsultationRecord[]
  recordConsents      RecordConsent[]

  @@unique([sessionId, tokenNumber])
  @@index([sessionId, status])
  @@index([patientId])
}

// Patients are not clinic-scoped: one patient account can hold tickets
// and records across multiple clinics.
model Patient {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  email        String?   @unique
  passwordHash String
  dateOfBirth  DateTime? @db.Date
  sex          String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  tokens              Token[]
  consultationRecords ConsultationRecord[]
  recordConsents      RecordConsent[]
  recordAccessEvents  RecordAccessEvent[]
}

model ConsultationRecord {
  id                   String   @id @default(cuid())
  patientId            String
  patient              Patient  @relation(fields: [patientId], references: [id])
  doctorId             String
  doctor               Doctor   @relation(fields: [doctorId], references: [id])
  clinicId             String
  clinic               Clinic   @relation(fields: [clinicId], references: [id])
  tokenId              String?
  token                Token?   @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  consultedAt          DateTime @db.Timestamptz(3)
  chiefComplaint       String?
  clinicalAssessment   String?
  diagnosisText        String?
  prescriptionText     String?
  followUpInstructions String?
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  @@index([patientId, consultedAt])
  @@index([doctorId, consultedAt])
}

model RecordConsent {
  id        String    @id @default(cuid())
  patientId String
  patient   Patient   @relation(fields: [patientId], references: [id])
  doctorId  String
  doctor    Doctor    @relation(fields: [doctorId], references: [id])
  clinicId  String
  clinic    Clinic    @relation(fields: [clinicId], references: [id])
  tokenId   String?
  token     Token?    @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  grantedAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  scope     String

  @@index([patientId, doctorId])
}

// Append-only audit trail of medical record access.
model RecordAccessEvent {
  id          String             @id @default(cuid())
  patientId   String
  patient     Patient            @relation(fields: [patientId], references: [id])
  clinicId    String
  clinic      Clinic             @relation(fields: [clinicId], references: [id])
  doctorId    String?
  doctor      Doctor?            @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  staffUserId String?
  staffUser   StaffUser?         @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  action      RecordAccessAction
  reason      String?
  occurredAt  DateTime           @db.Timestamptz(3)
  metadata    Json?

  @@index([patientId, occurredAt])
}

model QueueEvent {
  id               String         @id @default(cuid())
  sessionId        String
  session          Session        @relation(fields: [sessionId], references: [id])
  tokenId          String?
  token            Token?         @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  actorStaffUserId String?
  actorStaffUser   StaffUser?     @relation(fields: [actorStaffUserId], references: [id], onDelete: SetNull)
  type             QueueEventType
  occurredAt       DateTime       @db.Timestamptz(3)
  metadata         Json?

  @@index([sessionId, occurredAt])
}

model PredictionSnapshot {
  id                   String   @id @default(cuid())
  tokenId              String
  token                Token    @relation(fields: [tokenId], references: [id])
  sessionId            String
  session              Session  @relation(fields: [sessionId], references: [id])
  modelVersion         String
  predictedStartAt     DateTime @db.Timestamptz(3)
  windowStartAt        DateTime @db.Timestamptz(3)
  windowEndAt          DateTime @db.Timestamptz(3)
  tokensAhead          Int
  medianServiceSeconds Int
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  @@index([tokenId, createdAt])
}

// General system audit log (distinct from the medical-record-specific
// RecordAccessEvent and the queue-specific QueueEvent). actorUserId is
// intentionally not a foreign key: the actor may be a StaffUser or a
// Patient, and DATA_MODEL.md does not specify which.
model AuditEvent {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  occurredAt  DateTime @db.Timestamptz(3)
  metadata    Json?

  @@index([clinicId, occurredAt])
}

// The ApnaHealth review team: staff of the platform, not of any clinic.
// Deliberately a separate table rather than a fourth StaffRole, because
// StaffUser.clinicId is required and every staff query is scoped by it —
// bolting a tenant-less role onto that model would put a hole straight
// through the isolation invariant. A PlatformAdmin has its own table, its
// own session cookie and its own /admin routes, and can never be produced
// by public signup: accounts are created out-of-band (npm run admin:create).
model PlatformAdmin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  reviewedClinics     Clinic[]             @relation("ClinicReviewedBy")
  verifiedDoctors     Doctor[]             @relation("DoctorVerifiedByAdmin")
  doctorVerifications DoctorVerification[]
  adminEvents         AdminEvent[]
}

// AuditEvent is scoped to a clinic by design (DATA_MODEL.md), so it cannot
// record platform-level actions — approving a facility is an act *about* a
// clinic by someone outside it. This is the platform-side equivalent, and
// is likewise append-only.
model AdminEvent {
  id         String        @id @default(cuid())
  adminId    String
  admin      PlatformAdmin @relation(fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String?
  occurredAt DateTime      @db.Timestamptz(3)
  metadata   Json?

  @@index([occurredAt])
}

// Single-use, short-lived password reset grant. Stores only a SHA-256 hash
// of the token — the plaintext exists solely in the emailed link, so a leak
// of this table cannot be replayed, the same reasoning as passwordHash.
//
// Polymorphic (kind + accountId, no FK) because it serves all three account
// tables; see AccountKind. Rows are never updated except to stamp usedAt,
// and expired ones are pruned opportunistically when a reset is requested.
model PasswordResetToken {
  id          String      @id @default(cuid())
  kind        AccountKind
  accountId   String
  tokenHash   String      @unique
  expiresAt   DateTime    @db.Timestamptz(3)
  usedAt      DateTime?   @db.Timestamptz(3)
  requestedIp String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  @@index([kind, accountId])
  @@index([expiresAt])
}
